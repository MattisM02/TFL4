FROM ghcr.io/graalvm/jdk-community:25

WORKDIR /app

COPY target/jvm-optim-demo-0.0.1-SNAPSHOT.jar app.jar

# EBICS config, PKCS#12 keys
COPY ebics/ebicsclient.config ebics/ebicsclient_a00.p12 ebics/ebicsclient_e00.p12 ebics/ebicsclient_x00.p12 /app/ebics/

# JAVA_TOOL_OPTIONS is set dynamically by the benchmark via -e flag.
# Do NOT hardcode it here — the benchmark needs to control JVM flags per config.

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
