    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <includeSystemScope>true</includeSystemScope>
                    <excludes>
                        <!-- EK ships log4j-slf4j-impl which conflicts with Spring Boot's log4j-to-slf4j -->
                        <exclude>
                            <groupId>de.travic</groupId>
                            <artifactId>log4j-slf4j-impl</artifactId>
                        </exclude>
                        <!-- EK ships slf4j-api 1.7 which conflicts with Spring Boot's slf4j-api 2.x -->
                        <exclude>
                            <groupId>de.travic</groupId>
                            <artifactId>slf4j-api</artifactId>
                        </exclude>
                        <!-- EK ships log4j-jcl which conflicts with Spring Boot's commons-logging bridge -->
                        <exclude>
                            <groupId>de.travic</groupId>
                            <artifactId>log4j-jcl</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>de.mattis.resourcenoptimierung.bench.BenchCli</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

