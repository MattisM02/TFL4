FROM eclipse-temurin:25-jre

WORKDIR /app

COPY target/jvm-optim-demo-0.0.1-SNAPSHOT.jar app.jar

# EBICS config, PKCS#12 keys
COPY ebics/ebicsclient.config ebics/ebicsclient_a00.p12 ebics/ebicsclient_e00.p12 ebics/ebicsclient_x00.p12 /app/ebics/

# Test file is generated at runtime by EkController.createTestFile()
# (realistic pain.001.003.03 SEPA Credit Transfer XML)

# Virtual Threads (Project Loom) aktivieren.
# Spring Boot 3.2+ schaltet damit Tomcat auf Virtual Threads um.
# JAVA_TOOL_OPTIONS wird weiterhin dynamisch durch den Benchmark gesetzt.
ENV SPRING_THREADS_VIRTUAL_ENABLED=true

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
